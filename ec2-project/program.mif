-- Programa GCD (Máximo Común Divisor) para EC-2
DEPTH = 32;
WIDTH = 8;
ADDRESS_RADIX = BIN;
DATA_RADIX = BIN;

CONTENT
BEGIN
  00000 : 10000000;   -- 0:  IN A
  00001 : 00111110;   -- 1:  STORE 30
  00010 : 10000000;   -- 2:  IN A
  00011 : 00111111;   -- 3:  STORE 31
  00100 : 00011110;   -- 4:  LOAD 30
  00101 : 01111111;   -- 5:  SUB 31
  00110 : 10110000;   -- 6:  JZ 16
  00111 : 11001100;   -- 7:  JPOS 12
  01000 : 00011111;   -- 8:  LOAD 31
  01001 : 01111110;   -- 9:  SUB 30
  01010 : 00111111;   -- 10: STORE 31
  01011 : 11000100;   -- 11: JPOS 4
  01100 : 00011110;   -- 12: LOAD 30
  01101 : 01111111;   -- 13: SUB 31
  01110 : 00111110;   -- 14: STORE 30
  01111 : 11000100;   -- 15: JPOS 4
  10000 : 00011110;   -- 16: LOAD 30 (salir)
  10001 : 11100000;   -- 17: HALT
END;
